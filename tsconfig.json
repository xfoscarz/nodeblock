{
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": null,
        
        "lib": ["es2025"],
        "target": "es2025",

        "strict": true,
        "alwaysStrict": true,

        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,

        
        "skipLibCheck": true,
        
        "incremental": false,
        "composite": false,
        
        "paths": {
            "@generated/*": [ "./Generated/*" ],
            "@/*": [ "./src/*" ],
            "@shared/*": [ "./Shared/*" ]
        },

        "types": [ "node" ]
    },
    "include": [
        "src",
        "Generated",
        "esbuild.ts",
        "Shared"
    ]
}